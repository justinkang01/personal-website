{
  "enabled": true,
  "name": "Pre-PR Checks",
  "description": "Runs tests, type checking, lint, and formatting before opening a PR",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before opening a pull request, run the following checks in order and stop if any fail:\n1. `bun run format` — auto-format all source files\n2. `bun run lint:fix` — auto-fix lint issues, then report any remaining errors\n3. `bun run build` — verify no TypeScript compilation errors\n4. `bun test` — ensure all tests pass\n\nIf any step fails, report the error output and do not proceed with opening the PR. If all steps pass, confirm and proceed."
  }
}
